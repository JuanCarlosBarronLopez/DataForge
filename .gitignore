# Entorno y credenciales
.env
.env.*
!.env.example

# Dependencias gestionadas por Composer
/vendor/

# Artefactos de compilacion, pruebas y analisis
/build/

# Directorios de trabajo en tiempo de ejecucion. Se versionan las carpetas
# vacias (con su .gitignore) para que existan en un clon nuevo.
/storage/**
!/storage/logs/
!/storage/cache/
!/storage/framework/
!/storage/framework/sessions/
!/storage/uploads/
!/storage/uploads/avatars/
!/storage/**/.gitkeep
!/storage/**/.gitignore

# PHPUnit
/.phpunit.cache/
.phpunit.result.cache

# Archivos de sistema y editores
/.vscode/
/.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporales
*.tmp
*.bak
*.cache
*.log
