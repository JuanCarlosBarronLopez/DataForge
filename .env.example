# ============================================
# DataForge - Configuracion de entorno
# ============================================
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
#
# El archivo .env NUNCA se sube al control de versiones.
# Si no existe .env, la aplicacion arranca con estos valores por defecto.

# ─── Aplicacion ───────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_NAME="DataForge"
APP_URL=http://localhost:8080
APP_VERSION=4.0.0

# Clave de cifrado para firmar cookies de sesion (64 caracteres hexadecimales).
# Genera una con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ─── Base de datos ────────────────────────────────────────────────────────
# Docker Compose
DB_HOST=db
DB_PORT=3306
DB_USER=dataforge
DB_PASS=cambia_esta_contrasena
DB_CHARSET=utf8mb4

# Base de datos de sistema (usuarios, registro de auditoria, registro de bases)
SYSTEM_DB=dataforge_system

# Conexion alternativa en formato URL (TiDB Cloud, PlanetScale, Railway).
# Si se define, sobrescribe DB_HOST, DB_PORT, DB_USER, DB_PASS y SYSTEM_DB.
# MYSQL_URL=mysql://usuario:clave@host:puerto/base

# ─── Puertos de Docker Compose (solo desarrollo local) ────────────────────
APP_PORT=8080
DB_EXTERNAL_PORT=3307
PMA_PORT=8081
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root

# ─── Redis (rate limiting) ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# "file" (sistema de archivos, sin dependencias) o "redis"
RATE_LIMIT_STORAGE=file

# ─── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=300

# ─── Sesion ───────────────────────────────────────────────────────────────
# Segundos de inactividad antes de cerrar la sesion (30 minutos).
SESSION_IDLE_TIMEOUT=1800
# Segundos de duracion maxima de la sesion (8 horas).
SESSION_ABSOLUTE_TIMEOUT=28800
# IPs (o CIDR) de proxies de confianza. Separadas por coma. Vacio = no confiar en proxies.
TRUSTED_PROXIES=

# ─── Consultas SQL ────────────────────────────────────────────────────────
# Numero maximo de filas devueltas por la consola SQL.
QUERY_MAX_ROWS=500
# Limite de tiempo de ejecucion de una consulta en segundos.
QUERY_TIMEOUT=10
