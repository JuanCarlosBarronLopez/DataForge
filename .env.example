# ============================================
# DataForge — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!

# ─── Database Configuration ────────────────────────────────────────────────
# Local (Docker Compose)
DB_HOST=db
DB_PORT=3306
DB_USER=dataforge
DB_PASS=your_secure_password_here
DB_CHARSET=utf8mb4

# Production (External MySQL — e.g. TiDB Cloud, PlanetScale)
# Uncomment and fill these for cloud deployment:
# MYSQL_URL=mysql://user:pass@host:port/dbname

# ─── Application Configuration ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_NAME="DataForge CRUD Manager"
APP_VERSION=3.2.0
APP_URL=http://localhost:8080
SYSTEM_DB=dataforge_system

# ─── Docker Compose Ports ──────────────────────────────────────────────────
APP_PORT=8080
DB_EXTERNAL_PORT=3307
PMA_PORT=8081
MYSQL_ROOT_PASSWORD=root_secret

# ─── Redis (Rate Limiting) ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_STORAGE=file
# Options: "file" (filesystem-based) or "redis" (requires Redis)

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
