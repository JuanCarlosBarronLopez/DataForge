storage/framework/*
storage/uploads/*
!storage/**/.gitkeep
!storage/**/.gitignore

# Documentacion interna de desarrollo
docs/private/

# Archivos de sistema y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
.DS_Store
Thumbs.db

# Temporales
*.tmp
*.bak
*.cache
*.log
